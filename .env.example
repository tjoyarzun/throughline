# Throughline environment. Copy to .env.local and fill in.
# Never commit .env*. See docs/security.md#secrets-and-rotation.

# --- Database (Neon) ---
DATABASE_URL=
DATABASE_URL_POOLED=

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- External media providers ---
TMDB_API_KEY=

# --- Scheduled jobs ---
CRON_SECRET=

# --- Rate limiting (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Public ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
