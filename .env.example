# Throughline environment. Copy to .env.local and fill in.
# Never commit .env*. See docs/security.md#secrets-and-rotation.

# --- Database (Neon) ---
# Injected by the Neon integration on Vercel. Names match Neon's convention
# exactly — do not rename, or `pnpm check-env` will fail against the real env.
#
#   DATABASE_URL           POOLED (pgbouncer, transaction mode). The application.
#                          Safe for withUser(): SET LOCAL is transaction-scoped,
#                          so RLS works through the pooler. Plain SET would NOT be.
#   DATABASE_URL_UNPOOLED  DIRECT. Migrations (DDL, advisory locks) and the seed
#                          script. Never used to serve a request.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Authentication connects as the app_auth role, NOT app_web. Sign-in must find
# a user by email before any session exists, and usr.account has FORCE ROW
# LEVEL SECURITY. app_auth carries a role-targeted policy permitting exactly
# that and has no grant on ratings, viewing history, notes or shares.
# See docs/security.md#the-authentication-bootstrap.
AUTH_DATABASE_URL=

# Sign-in code delivery. Without these, sign-in generates a code and never
# sends it — so production REFUSES to start the flow rather than failing
# silently. Development logs the code to the server console instead.
# Development logs the code even when a key is present, because Resend's
# unverified-domain mode only delivers to the account owner. Set the optional
# EMAIL_DEV_DELIVER=1 to exercise real delivery locally. It is deliberately not
# declared below: check-env requires an exact name match, so every declared var
# is mandatory.
RESEND_API_KEY=
EMAIL_FROM=

# --- External media providers ---
# Use the v4 "API Read Access Token" (Bearer), NOT the v3 API key.
# The v3 key travels in the query string, and our structured logging records
# request paths — that would write the credential into logs. See docs/api.md.
TMDB_READ_ACCESS_TOKEN=

# --- Scheduled jobs ---
CRON_SECRET=

# --- Rate limiting (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Public ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
