{
  "name": "throughline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build",
    "check-drift": "tsx scripts/check-drift.ts",
    "check-env": "tsx scripts/check-env.ts",
    "check-layers": "bash scripts/check-layers.sh",
    "check-locale": "bash scripts/check-locale.sh",
    "check-spelling": "cspell --no-progress --no-summary \"**/*.{ts,tsx,md,yaml,yml,css}\"",
    "check-vercel": "tsx scripts/check-vercel.ts",
    "codegen": "tsx ontology/codegen.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:test-role": "tsx scripts/db-test-role.ts",
    "derive:themes": "tsx scripts/derive-themes.ts",
    "derive:similar": "tsx scripts/derive-similar.ts",
    "dev": "next dev",
    "e2e": "playwright test",
    "enrich:wikidata": "tsx scripts/enrich-wikidata.ts",
    "hydrate:people": "tsx --env-file-if-exists=.env.local scripts/hydrate-people.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "invite": "tsx scripts/invite.ts",
    "lint": "eslint .",
    "seed": "tsx scripts/seed.ts",
    "seed:prod-queue": "tsx scripts/seed-production-queue.ts",
    "seed:production": "bash scripts/seed-production.sh",
    "start": "next start",
    "test": "vitest run",
    "test:strict": "vitest run --reporter=json --outputFile=.vitest/json/output.json && tsx scripts/assert-no-skips.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "vercel-build": "pnpm db:migrate && next build",
    "verify": "pnpm check-drift && pnpm typecheck && pnpm lint && pnpm check-locale && pnpm check-spelling && pnpm check-layers && pnpm check-vercel && pnpm test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cspell": "^10.3.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
