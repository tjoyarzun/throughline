# Secrets. The negation MUST come last — gitignore resolves by LAST match,
# so a later broad `.env*` silently re-ignores .env.example. `vercel link`
# appends exactly that; if it comes back, delete it rather than reordering.
.env
.env.*
!.env.example
*.tsbuildinfo
next-env.d.ts
